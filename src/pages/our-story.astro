---
import AboutSections from "../components/AboutSections.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/kenya-savannah-hero.png";
import { pageTitle } from "../lib/site";

const description =
  "Amara Trails plans first Kenya safaris around the season, with clear pricing and a named team from planning to arrival. Meet the founders in Nairobi, Boston, and Ottawa.";
---

<BaseLayout
  title={pageTitle("Our Story")}
  description={description}
  canonicalPath="/our-story"
  current="about"
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Our Story", path: "/our-story" }
  ]}
>
    <Hero
      compact
      eyebrow="Our story"
      title="We'll tell you when."
      body="Amara Trails plans first safaris the way we would for a friend: reading the season, saying the price out loud, and staying reachable while you travel."
      image={heroImage}
      alt="Open Kenya savannah landscape stretching to the horizon at golden hour."
    />
    <AboutSections />
    <FinalCTA
      eyebrow="Find your way through Kenya"
      title="Let us help you find your way through Kenya."
      body="Tell us what you are imagining, even if the idea is still early. We will help make the choices clear."
    />
</BaseLayout>
